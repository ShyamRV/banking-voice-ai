# Backend Environment Variables for Payment System

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_ENV=development
APP_PORT=8000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://payment_user:payment_pass@localhost:5432/payment_system

# Connection pool settings
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a strong random string (min 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# ============================================
# FETCH.AI BLOCKCHAIN CONFIGURATION
# ============================================
# Network: testnet or mainnet
FETCH_NETWORK=testnet

# Chain ID
# Testnet: dorado-1
# Mainnet: fetchhub-4
FETCH_CHAIN_ID=dorado-1

# RPC Endpoint
# Testnet: https://rpc-dorado.fetch.ai:443
# Mainnet: https://rpc-fetchhub.fetch.ai:443
FETCH_RPC_URL=https://rpc-dorado.fetch.ai:443

# REST API Endpoint (optional)
FETCH_REST_URL=https://rest-dorado.fetch.ai

# ============================================
# CORS SETTINGS
# ============================================
# Comma-separated list of allowed origins
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# REDIS (OPTIONAL - for caching)
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log

# ============================================
# SECURITY
# ============================================
# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Password hashing rounds
BCRYPT_ROUNDS=12
